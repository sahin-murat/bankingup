        {
          "name": "Create Transfer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"transferIdempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns HTTP 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"moves money between accounts\", function () {",
                  "    const transfer = pm.response.json();",
                  "    pm.expect(transfer.source_account_id).to.eql(pm.collectionVariables.get(\"accountId\"));",
                  "    pm.expect(transfer.destination_account_id).to.eql(pm.collectionVariables.get(\"destinationAccountId\"));",
                  "    pm.expect(transfer.amount).to.eql(\"15\");",
                  "    pm.expect(transfer.currency).to.eql(\"EUR\");",
                  "    pm.expect(transfer.source_balance_after).to.eql(\"100.75\");",
                  "    pm.expect(transfer.destination_balance_after).to.eql(\"15\");",
                  "    pm.collectionVariables.set(\"transferId\", transfer.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
